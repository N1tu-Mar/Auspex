# Copy to .env to override local defaults. Fake local-only values; never commit real secrets.
# docker compose reads these for interpolation; the API validates DATABASE_URL at startup.

# PostgreSQL bootstrap superuser (container admin only; the app never uses it).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_only
POSTGRES_DB=auspex
POSTGRES_PORT=5432

# Non-superuser application role created by infra/postgres/init-app-role.sh.
APP_DB_USER=auspex_app
APP_DB_PASSWORD=auspex_app_local_only

# Used by the API, Alembic, and pytest when run on the host (outside Compose).
DATABASE_URL=postgresql+psycopg://auspex_app:auspex_app_local_only@localhost:5432/auspex

API_PORT=8000
WEB_PORT=5173
