{
  "openapi": "3.1.0",
  "info": {
    "title": "Auspex API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bet-slips/validate": {
      "post": {
        "summary": "Validate Bet Slip",
        "description": "Validate and normalize a slip without persisting it. 422 on invalid input.",
        "operationId": "validate_bet_slip_api_v1_bet_slips_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetSlip"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetSlip"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BetLeg": {
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/Sport"
          },
          "league": {
            "type": "string",
            "minLength": 1,
            "title": "League"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "event_start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Event Start Utc",
            "description": "Event start; any offset accepted, stored and returned as UTC."
          },
          "home_participant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Participant"
          },
          "away_participant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Away Participant"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          },
          "market_type": {
            "$ref": "#/components/schemas/MarketType"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "line": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line",
            "description": "Spread or total threshold."
          },
          "polymarket_market_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Polymarket Market Id"
          },
          "market_price_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,2}|(?=[\\d.]{1,7}0*$)\\d{0,2}\\.\\d{0,4}0*$)"
              }
            ],
            "title": "Market Price Usd"
          },
          "settlement_rule_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settlement Rule Ref"
          },
          "status": {
            "$ref": "#/components/schemas/LegStatus",
            "default": "PREGAME"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sport",
          "league",
          "event_start_utc",
          "market_type",
          "side",
          "market_price_usd"
        ],
        "title": "BetLeg"
      },
      "BetSlip": {
        "properties": {
          "original_input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Input",
            "description": "Verbatim user submission, kept for audit."
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/BetLeg"
            },
            "type": "array",
            "minItems": 1,
            "title": "Legs"
          },
          "stake_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Stake Usd"
          },
          "gross_payout_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gross Payout Usd",
            "description": "Quoted payout including returned stake; semantics confirmed per market."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "legs",
          "stake_usd"
        ],
        "title": "BetSlip"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "LegStatus": {
        "type": "string",
        "enum": [
          "PREGAME",
          "LIVE",
          "COMPLETED",
          "POSTPONED",
          "CANCELED",
          "UNSUPPORTED"
        ],
        "title": "LegStatus"
      },
      "MarketType": {
        "type": "string",
        "enum": [
          "MONEYLINE",
          "SPREAD",
          "TOTAL",
          "PLAYER_PROP"
        ],
        "title": "MarketType"
      },
      "Side": {
        "type": "string",
        "enum": [
          "HOME",
          "AWAY",
          "DRAW",
          "OVER",
          "UNDER",
          "YES",
          "NO"
        ],
        "title": "Side"
      },
      "Sport": {
        "type": "string",
        "enum": [
          "NFL",
          "NCAAF",
          "MLB",
          "SOCCER"
        ],
        "title": "Sport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
